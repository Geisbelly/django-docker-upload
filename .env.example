DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# porta publicada pelo nginx no host
NGINX_PORT=8080

# so fazem sentido com TLS na frente; deixe em 0 enquanto for HTTP puro
DJANGO_SECURE_COOKIES=0
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

# teto para uma consulta presa nao segurar um worker (milissegundos)
DB_STATEMENT_TIMEOUT_MS=15000

# regras do upload, validadas no model (app/core/validators.py)
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,odt,txt,csv,xls,xlsx,ods,png,jpg,jpeg,gif,webp
